# Allowed browser origins (comma-separated). Use * for permissive local dev.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Regex for forwarded dev URLs (Codespaces, GitHub.dev previews)
CORS_ORIGIN_REGEX=https://.*\.(app\.github\.dev|github\.dev)

# Optional override for supplier TinyDB file (default: services/api/suppliers.json)
# SUPPLIERS_DB_PATH=suppliers.json
