# Allowed browser origins (comma-separated). Use * for permissive local dev.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Regex for forwarded dev URLs (Codespaces, GitHub.dev previews)
CORS_ORIGIN_REGEX="https://.*\\.(app\\.github\\.dev|github\\.dev)"

# Optional override for supplier TinyDB file (default: services/api/suppliers.json)
# SUPPLIERS_DB_PATH=suppliers.json

# Authentication (required)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional override for auth TinyDB file (default: services/api/auth.json)
# AUTH_DB_PATH=auth.json

# Password reset (M9 — required for forgot/reset flows)
RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# Transactional email (Resend — required for forgot/reset flows)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inventory (M5.5) — SQLModel + psycopg3. Required at API startup.
# Session pooler (Connect → Session pooler). Direct db.*.supabase.co is IPv6-only (fails in Codespaces).
# URL-encode special characters in the password. Local without Postgres: sqlite:///./inventory.db
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Telemetry stub (M6.5). Frontend posts here; Phase 3 will persist. Unused for proxying today.
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Prefect Cloud (optional). Pipeline CLI + POST /reporting/pipeline-runs report flow runs
# to app.prefect.cloud when both are set. Do not commit real keys.
# Login: PREFECT_HOME="$(pwd)/.prefect" uv run prefect cloud login --key "$PREFECT_API_KEY"
# PREFECT_API_KEY=pnu_replace_me
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account_id>/workspaces/<workspace_id>

# Nightly export override (scripts/nightly_export.py). Default = yesterday UTC.
# TARGET_DATE=2026-09-07

# Desk knowledge / RAG (7.5)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=healthcore_knowledge
RAG_MIN_SCORE=0.35
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_GENERATION_MODEL=gpt-4o-mini
# RAG_API_KEY=sk-replace-me
# FOURGEEKS_API_KEY=
# RAG_BASE_URL=https://api.openai.com/v1
