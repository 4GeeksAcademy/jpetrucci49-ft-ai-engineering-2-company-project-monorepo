# Cross-app navigation — header links to other HealthCore apps (client-side).
# Defaults match local dev ports if unset; set explicitly for Codespaces or custom hosts.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001
NEXT_PUBLIC_TRACKER_URL=http://localhost:3002

# Server-side BFF proxy targets for FastAPI (not exposed to the browser).
# Used by app/api/incidents/* and app/api/suppliers/* route handlers.
INCIDENTS_API_URL=http://127.0.0.1:8000
SUPPLIERS_API_URL=http://127.0.0.1:8000
