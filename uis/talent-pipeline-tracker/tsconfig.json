{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@healthcore/auth": ["../../packages/shared/auth/index.ts"],
      "@healthcore/auth/*": ["../../packages/shared/auth/*"],
      "@healthcore/api/*": ["../../packages/shared/api/*"],
      "@healthcore/navigation": ["../../packages/shared/navigation/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/shared/auth/**/*.ts",
    "../../packages/shared/api/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
