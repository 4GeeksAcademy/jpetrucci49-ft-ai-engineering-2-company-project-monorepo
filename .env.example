# Docker Compose environment (gitignored as `.env`).
# Copy: cp .env.example .env
# Do not commit `.env`. Replace placeholders before using password reset or a hosted database.

# --- Browser / public URLs (developer machine, not the Docker network) ---
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001
NEXT_PUBLIC_TRACKER_URL=http://localhost:3002
PASSWORD_RESET_URL=http://localhost:3001/reset-password
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
CORS_ORIGIN_REGEX=https://.*\.(app\.github\.dev|github\.dev)

# --- UI container → API container (Compose DNS) ---
INCIDENTS_API_URL=http://api:8000
SUPPLIERS_API_URL=http://api:8000
AUTH_API_URL=http://api:8000
INVENTORY_API_URL=http://api:8000

# --- Next.js bind-mount file watching ---
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# --- API boot (required; placeholders only) ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=onboarding@resend.dev

# Local SQLite so compose up works without Supabase. Override in `.env` with a pooler URI if needed.
SUPABASE_DATABASE_URL=sqlite:///./inventory.db

# Telemetry stub (browser posts to host :8000; same URL in the API for the env pattern).
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Prefect Cloud (optional; copy into gitignored `.env`). Leave unset for local ephemeral API.
# PREFECT_API_KEY=pnu_replace_me
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account_id>/workspaces/<workspace_id>

# Nightly export (scripts/nightly_export.py). Omit for yesterday UTC.
# TARGET_DATE=2026-09-07

# Desk knowledge / RAG (7.5). Compose sets QDRANT_URL=http://qdrant:6333 on the API.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=healthcore_knowledge
RAG_MIN_SCORE=0.35
# 4Geeks student OpenAI-compatible models (embeddings ≠ generation).
# RAG_API_KEY=sk-replace-me
# FOURGEEKS_API_KEY=
# RAG_BASE_URL=https://api.openai.com/v1
# FOURGEEKS_BASE_URL=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_GENERATION_MODEL=gpt-4o-mini
